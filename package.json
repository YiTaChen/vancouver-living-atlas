{
  "name": "vancouver-living-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "dev": "node tools/verify-node-runtime.mjs && vinext dev --host 127.0.0.1",
    "build": "node tools/verify-node-runtime.mjs && vinext build",
    "build:firebase": "node tools/verify-node-runtime.mjs && VANCOUVER_STATIC_EXPORT=1 vinext build && node tools/verify-firebase-build.mjs && node tools/prepare-firebase-hosting.mjs",
    "deploy:firebase": "npm run build:firebase && firebase deploy --only hosting --config firebase.generated.json",
    "start": "node tools/verify-node-runtime.mjs && vinext start --hostname 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node tools/verify-node-runtime.mjs && node --test tests/*.test.mjs",
    "check": "node tools/verify-node-runtime.mjs && tsc --noEmit --incremental false",
    "preinstall": "node tools/verify-node-runtime.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "delaunator": "^5.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/delaunator": "^5.0.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "oxfmt": "0.74.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "playwright": "1.63.0"
  },
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
